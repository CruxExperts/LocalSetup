# LocalSetup framework source repo
*.backup
*.local
.DS_Store
*.log

# Secret-bearing local artifacts
.cloudflare/
*.kdbx
*.kdbx.*
*.keyfile
*.keyx
.env
.env.*
!.env.example

# Local-only generated maintenance docs
_internal_docs/
ls/.localsetup-meta/

# Repo-local data (PR review state, audit output, etc.; never publish)
data/
!ls/skills/ls-nodejs-nextjs/data/
!ls/skills/ls-nodejs-nextjs/data/verified-versions.json
!ls/skills/ls-github-starredrepos/data/
!ls/skills/ls-github-starredrepos/data/**

# Mail accounts (credentials; use example template only in repo)
ls/config/mail_accounts.json
ls/.cache/
ls/logs/

# Agent work queue (local-only PRDs and task files; never publish)
.agent/

# Git state snapshots (unfuck-my-git-state diagnostic output; never publish)
.git-state-snapshots/

# Repo maintenance scripts (local-only, not shipped)
/scripts/

# Internal/maintainer docs (not shipped; public docs live in ls/docs/)
docs/
!ls/docs/
!ls/docs/**
!ls/skills/*/docs/
!ls/skills/*/docs/**

# Contribution artifacts (local-only, not shipped)
contributions/

# Python
/build/
/dist/
__pycache__/
*.pyc
*.pyo
*.egg-info/
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# LocalSetup install output (machine-local runtime state; never publish)
.localsetup/
localsetup.lock.json
.codex/skills
.agents/state/
.codex/runs/
.codex/sessions/
.codex/logs/
.codex/tmp/
.codex/*.backup
.claude/skills
.cursor/skills
.kilo/skills
.opencode/skills
.openclaw/skills

# Graphify local state and generated indexes
.graphify_*
.graphifyignore
graphify-out/

# Kilo Code local state.
.kilocode/
.kilo/*
ls/.kilo/

# Codex CLI context: track the repo guide; generated skills adapter is install output.
!AGENTS.md

# LocalSetup maintainer-private state
state/
.localsetup-maint/boundary.yaml
.localsetup-maint/config/
.localsetup-maint/imports/
.localsetup-maint/prompts/
.localsetup-maint/reports/
.localsetup-maint/state/
.localsetup-maint/docs/
.localsetup-maint/ui-browser-artifacts/
.localsetup-maint/ui-browser-profiles/
.localsetup-maint/ui-browser-sessions/

