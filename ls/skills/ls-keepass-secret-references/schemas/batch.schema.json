{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LocalSetup secrets batch",
  "type": "object",
  "required": ["items"],
  "properties": {
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
          },
          "username": {
            "type": "string"
          },
          "service_type": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "rotate_password": {
            "type": "boolean"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
