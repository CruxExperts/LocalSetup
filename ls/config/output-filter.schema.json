{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LocalSetup bounded output filter policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "rules", "limits"],
  "properties": {
    "schema_version": {"const": 1, "type": "integer"},
    "limits": {
      "type": "object", "additionalProperties": false,
      "required": ["max_text_bytes", "max_matches", "timeout_ms"],
      "properties": {
        "max_text_bytes": {"type": "integer", "minimum": 1, "maximum": 1048576},
        "max_matches": {"type": "integer", "minimum": 1, "maximum": 4096},
        "timeout_ms": {"type": "integer", "minimum": 1, "maximum": 1000}
      }
    },
    "rules": {
      "type": "array", "maxItems": 64,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["order", "sinks", "match", "pattern", "action"],
        "properties": {
          "order": {"type": "integer", "minimum": 1, "maximum": 2147483647},
          "sinks": {"type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true,
                    "items": {"enum": ["observation", "retained-log", "agent-context"]}},
          "match": {"enum": ["word", "regex"]},
          "pattern": {"type": "string", "minLength": 1, "maxLength": 256},
          "action": {"enum": ["replace", "block", "quarantine", "halt"]},
          "replacement": {"type": "string", "maxLength": 4096}
        },
        "if": {"properties": {"action": {"const": "replace"}}},
        "then": {"required": ["replacement"]},
        "else": {"not": {"required": ["replacement"]}}
      }
    }
  }
}
