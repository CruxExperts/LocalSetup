{
  "schema_version": 1,
  "application": "tmux",
  "name": "agent-shell",
  "required_features": [],
  "extensions": {},
  "settings": {
    "baseline": {
      "prefix": "None",
      "prefix2": "None",
      "window_size": "manual",
      "ignore_observer_size": true,
      "observer_read_only_on_attach": true,
      "status_rows": 1,
      "status_interval_seconds": 5
    },
    "theme": {
      "background": "#061020",
      "surface": "#0B1830",
      "text": "#FFFFFF",
      "muted": "#BFD2E8",
      "border": "#35699C",
      "accent": "#41B8FF",
      "toolbar": "#073B73",
      "control": "#B9E2FF",
      "control_text": "#06233A",
      "selected": "#42DDF7",
      "selection_text": "#06233A",
      "attention": "#FFB52E"
    },
    "keys": {
      "Any": "ignore",
      "PPage": "copy_mode_up",
      "WheelUpPane": "copy_mode_mouse",
      "C-q": "detach"
    },
    "layout": {
      "canvas_columns": 120,
      "quiet_seconds": 5,
      "expanded_min_rows": 10,
      "max_sections": 8,
      "activity_coalesce_ms": 250,
      "resize_debounce_ms": 250,
      "max_rows": 512,
      "pane_border_status": "top",
      "pane_border_format": "#{@localsetup_shell_label}",
      "anchor_rows": 1,
      "min_pane_rows": 3,
      "retained_history_lines": 6000,
      "retained_text_bytes": 20000000,
      "capture_bytes": 20000000,
      "native_canvas": {
        "default_columns": 120,
        "default_rows": 24,
        "minimum_pane_rows": 3,
        "anchor_rows": 1,
        "quiet_seconds": 10,
        "automatic_view_min_seconds": 2,
        "activity_coalesce_ms": 250,
        "resize_debounce_ms": 250,
        "ratio_step_percent": 10,
        "ratio_max": 10000
      }
    },
    "context": {
      "max_lines": 200,
      "max_output_bytes": 32768,
      "max_json_bytes": 65536
    },
    "progress": {
      "join_reminder_seconds": 300
    },
    "recovery": {
      "idle_label": "Idle",
      "completed_label": "Completed · Idle",
      "known_apps": {
        "less": {"enabled": true, "action": "quit_q", "max_attempts": 1, "observe_seconds": 3}
      }
    }
  }
}
