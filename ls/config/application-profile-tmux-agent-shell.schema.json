{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://localsetup.dev/schemas/application-profile-tmux-agent-shell.schema.json",
  "title": "LocalSetup tmux agent-shell profile settings",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "mouse": { "type": "boolean" },
    "history_limit": { "type": "integer", "minimum": 100, "maximum": 1000000 },
    "status_position": { "type": "string", "enum": ["top", "bottom"] },
    "status": { "type": "boolean" },
    "preserve_theme": { "type": "boolean", "const": true },
    "default_lines": { "type": "integer", "minimum": 1, "maximum": 10000 },
    "max_response_bytes": { "type": "integer", "minimum": 1024, "maximum": 262144 },
    "log_max_bytes": { "type": "integer", "minimum": 1048576, "maximum": 4294967296 },
    "completed_log_retention_days": { "type": "integer", "minimum": 0, "maximum": 3650 },
    "idle_grace_seconds": { "type": "integer", "minimum": 0, "maximum": 604800 },
    "collector_interval_seconds": { "type": "integer", "const": 60 },
    "observer_pins": { "type": "boolean", "const": true }
  }
}
