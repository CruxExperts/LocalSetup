{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://localsetup.dev/schemas/application-profile.schema.json",
  "title": "LocalSetup application profile document",
  "type": "object",
  "required": ["schema_version", "application", "name", "base_profile", "settings"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1, "type": "integer" },
    "application": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
    "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
    "base_profile": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
    "settings": { "type": "object" }
  }
}
