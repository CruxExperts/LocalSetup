{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://localsetup.dev/schemas/install.schema.json",
  "title": "LocalSetup install config",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "platforms": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "packs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true,
      "description": "Legacy shared pack selector. Omit selector fields for the fresh normal global baseline."
    },
    "preset": {
      "type": "string",
      "enum": ["core", "normal", "suggested", "all", "custom"],
      "description": "Named selection preset. Fresh selector-free installs use the normal global baseline."
    },
    "skills": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "skill_classes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "skill_tags": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "exclude_skills": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "workflows": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "global_packs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true,
      "description": "Managed package-library baseline packs."
    },
    "global_preset": {
      "type": "string",
      "enum": ["core", "normal", "suggested", "all", "custom"],
      "description": "Managed package-library baseline preset."
    },
    "global_skills": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "global_skill_classes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "global_skill_tags": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "global_exclude_skills": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "global_workflows": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "repo_packs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true,
      "description": "Repo-visible packs exposed through selected adapter paths."
    },
    "repo_preset": {
      "type": "string",
      "enum": ["core", "normal", "suggested", "all", "custom"],
      "description": "Repo-visible selection preset."
    },
    "repo_skills": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "repo_skill_classes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "repo_skill_tags": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "repo_exclude_skills": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "repo_workflows": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "skill_scope": {
      "type": ["string", "null"],
      "enum": ["repo", "personal", "both", null],
      "description": "Adapter ownership scope. Omitted or null retains recorded scope, defaulting to repo for a fresh target; this does not select clients."
    },
    "attach_mode": {
      "type": "string",
      "enum": ["symlink", "portable"],
      "default": "symlink"
    },
    "home": {
      "type": "string",
      "minLength": 1
    },
    "target_directory": {
      "type": "string",
      "minLength": 1,
      "description": "Directory where repo adapter links and .localsetup/lock.json are written. Defaults to the detected target."
    },
    "data_root": {
      "type": "string",
      "minLength": 1,
      "description": "Optional root for managed runtime state. Dependency environments are uv project environments under the LocalSetup source checkout."
    },
    "dependency_mode": {
      "type": "string",
      "enum": ["uv-sync", "prompt-only", "managed-venv", "user-pip"],
      "default": "prompt-only",
      "description": "Dependency handling mode. Use uv-sync for explicit uv-managed project sync or prompt-only to report without syncing. managed-venv and user-pip are deprecated compatibility aliases."
    },
    "migration_mode": {
      "type": "string",
      "enum": ["conservative-auto", "report-only"],
      "default": "conservative-auto"
    },
    "backup_dir": {
      "type": "string",
      "minLength": 1
    },
    "backup_policy": {
      "type": "string",
      "enum": ["timestamped"],
      "default": "timestamped"
    },
    "feedback": {
      "type": "object",
      "additionalProperties": false,
      "description": "Private automatic failure capture and optional explicit GitHub issue destination. Credentials are never stored here.",
      "properties": {
        "repository": { "type": "string", "pattern": "^[A-Za-z0-9-]+/[A-Za-z0-9._-]+$" },
        "labels": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 50 }, "uniqueItems": true },
        "capture_enabled": { "type": "boolean", "default": true },
        "auto_draft": { "type": "boolean", "default": true }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "json": {
          "type": "boolean",
          "default": true,
          "description": "Explicit JSON output preference. JSON is the default for non-Markdown commands."
        },
        "report": { "type": "string", "minLength": 1 },
        "markdown": { "type": "boolean", "default": false }
      }
    }
  }
}
