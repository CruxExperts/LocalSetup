{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LocalSetup private tmux runtime profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "application", "name", "settings"],
  "properties": {
    "schema_version": {"type": "integer", "minimum": 1},
    "application": {"const": "tmux"},
    "name": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
    "required_features": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"type": "string", "maxLength": 64}},
    "extensions": {"type": "object", "maxProperties": 32},
    "settings": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "native_shortcuts": {"type": "object", "additionalProperties": false,
          "properties": {
          "menu": {"enum": ["F1", "F2", "F3", "F4", "F5", "F6", "F7", "F8", "F9", "F10", "F11", "F12", "Tab", "BTab", "Enter", "Up", "Down"]},
          "focus_next": {"enum": ["F1", "F2", "F3", "F4", "F5", "F6", "F7", "F8", "F9", "F10", "F11", "F12", "Tab", "BTab", "Enter", "Up", "Down"]},
          "focus_previous": {"enum": ["F1", "F2", "F3", "F4", "F5", "F6", "F7", "F8", "F9", "F10", "F11", "F12", "Tab", "BTab", "Enter", "Up", "Down"]},
          "activate": {"enum": ["F1", "F2", "F3", "F4", "F5", "F6", "F7", "F8", "F9", "F10", "F11", "F12", "Tab", "BTab", "Enter", "Up", "Down"]},
          "previous": {"enum": ["F1", "F2", "F3", "F4", "F5", "F6", "F7", "F8", "F9", "F10", "F11", "F12", "Tab", "BTab", "Enter", "Up", "Down"]},
          "next": {"enum": ["F1", "F2", "F3", "F4", "F5", "F6", "F7", "F8", "F9", "F10", "F11", "F12", "Tab", "BTab", "Enter", "Up", "Down"]}
          }
        },
        "inspection_enabled": {"type": "boolean"},
        "auto_close_completed": {"type": "boolean"},
        "toolbar_visible": {"type": "boolean"},
        "shortcut_hints_visible": {"type": "boolean"},
        "colors_enabled": {"type": "boolean"},
        "startup_mode": {"enum": ["follow", "stable", "fixed"]},
        "inspection_duration_seconds": {"type": "integer", "minimum": 1, "maximum": 300},
        "reflow_debounce_ms": {"type": "integer", "minimum": 0, "maximum": 1000},
        "double_escape_ms": {"type": "integer", "minimum": 100, "maximum": 2000},
        "auto_close_delay_seconds": {"type": "integer", "minimum": 0, "maximum": 3600},
        "completed_hide_seconds": {"type": "integer", "minimum": 1, "maximum": 86400},
        "client_activity_enabled": {"type": "boolean"},
        "client_activity_interval_seconds": {"type": "integer", "minimum": 1, "maximum": 60},
        "status_detail": {"enum": ["minimal", "standard", "detailed"]},
        "baseline": {"type": "object", "additionalProperties": false, "properties": {
          "prefix": {"const": "None"}, "prefix2": {"const": "None"}, "window_size": {"const": "manual"},
          "ignore_observer_size": {"const": true}, "observer_read_only_on_attach": {"const": true},
          "status_rows": {"type": "integer", "enum": [1, 2]}, "status_interval_seconds": {"type": "integer", "minimum": 1, "maximum": 60}
        }},
        "theme": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "background": {
                  "type": "string",
                  "pattern": "^#[0-9A-Fa-f]{6}$"
                },
                "surface": {
                  "type": "string",
                  "pattern": "^#[0-9A-Fa-f]{6}$"
                },
                "text": {
                  "type": "string",
                  "pattern": "^#[0-9A-Fa-f]{6}$"
                },
                "muted": {
                  "type": "string",
                  "pattern": "^#[0-9A-Fa-f]{6}$"
                },
                "border": {
                  "type": "string",
                  "pattern": "^#[0-9A-Fa-f]{6}$"
                },
                "accent": {
                  "type": "string",
                  "pattern": "^#[0-9A-Fa-f]{6}$"
                },
                "toolbar": {
                  "type": "string",
                  "pattern": "^#[0-9A-Fa-f]{6}$"
                },
                "control": {
                  "type": "string",
                  "pattern": "^#[0-9A-Fa-f]{6}$"
                },
                "control_text": {
                  "type": "string",
                  "pattern": "^#[0-9A-Fa-f]{6}$"
                },
                "selected": {
                  "type": "string",
                  "pattern": "^#[0-9A-Fa-f]{6}$"
                },
                "selection_text": {
                  "type": "string",
                  "pattern": "^#[0-9A-Fa-f]{6}$"
                },
                "attention": {
                  "type": "string",
                  "pattern": "^#[0-9A-Fa-f]{6}$"
                },
                "success": {
                  "type": "string",
                  "pattern": "^#[0-9A-Fa-f]{6}$"
                },
                "error": {
                  "type": "string",
                  "pattern": "^#[0-9A-Fa-f]{6}$"
                },
                "running": {
                  "type": "string",
                  "pattern": "^#[0-9A-Fa-f]{6}$"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "schema_version",
                "name",
                "description",
                "roles"
              ],
              "properties": {
                "schema_version": {
                  "const": 1
                },
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                },
                "description": {
                  "type": "string",
                  "maxLength": 256
                },
                "roles": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "background": {
                      "type": "string",
                      "pattern": "^#[0-9A-Fa-f]{6}$"
                    },
                    "surface": {
                      "type": "string",
                      "pattern": "^#[0-9A-Fa-f]{6}$"
                    },
                    "text": {
                      "type": "string",
                      "pattern": "^#[0-9A-Fa-f]{6}$"
                    },
                    "muted": {
                      "type": "string",
                      "pattern": "^#[0-9A-Fa-f]{6}$"
                    },
                    "border": {
                      "type": "string",
                      "pattern": "^#[0-9A-Fa-f]{6}$"
                    },
                    "accent": {
                      "type": "string",
                      "pattern": "^#[0-9A-Fa-f]{6}$"
                    },
                    "toolbar": {
                      "type": "string",
                      "pattern": "^#[0-9A-Fa-f]{6}$"
                    },
                    "control": {
                      "type": "string",
                      "pattern": "^#[0-9A-Fa-f]{6}$"
                    },
                    "control_text": {
                      "type": "string",
                      "pattern": "^#[0-9A-Fa-f]{6}$"
                    },
                    "selected": {
                      "type": "string",
                      "pattern": "^#[0-9A-Fa-f]{6}$"
                    },
                    "selection_text": {
                      "type": "string",
                      "pattern": "^#[0-9A-Fa-f]{6}$"
                    },
                    "attention": {
                      "type": "string",
                      "pattern": "^#[0-9A-Fa-f]{6}$"
                    },
                    "success": {
                      "type": "string",
                      "pattern": "^#[0-9A-Fa-f]{6}$"
                    },
                    "error": {
                      "type": "string",
                      "pattern": "^#[0-9A-Fa-f]{6}$"
                    },
                    "running": {
                      "type": "string",
                      "pattern": "^#[0-9A-Fa-f]{6}$"
                    }
                  },
                  "required": [
                    "background",
                    "surface",
                    "text",
                    "muted",
                    "border",
                    "accent",
                    "toolbar",
                    "control",
                    "control_text",
                    "selected",
                    "selection_text",
                    "attention"
                  ]
                }
              }
            }
          ]
        },
        "keys": {"type": "object", "additionalProperties": false, "properties": {
          "Any": {"const": "ignore"}, "PPage": {"const": "copy_mode_up"},
          "WheelUpPane": {"const": "copy_mode_mouse"}, "C-q": {"const": "detach"}
        }},
        "layout": {"type": "object", "additionalProperties": false, "properties": {
          "canvas_columns": {"type": "integer", "minimum": 80, "maximum": 500}, "max_rows": {"const": 512},
          "quiet_seconds": {"type": "integer", "minimum": 1, "maximum": 300},
          "expanded_min_rows": {"type": "integer", "minimum": 2, "maximum": 100},
          "max_sections": {"type": "integer", "minimum": 1, "maximum": 64},
          "activity_coalesce_ms": {"type": "integer", "minimum": 50, "maximum": 1000},
          "resize_debounce_ms": {"type": "integer", "minimum": 50, "maximum": 1000},
          "pane_border_status": {"const": "top"},
          "pane_border_format": {"const": "#{@localsetup_shell_label}"},
          "anchor_rows": {"const": 1}, "min_pane_rows": {"const": 3},
          "retained_history_lines": {"type": "integer", "minimum": 100, "maximum": 9000}, "retained_text_bytes": {"const": 20000000},
          "capture_bytes": {"const": 20000000},
          "native_canvas": {"type": "object", "additionalProperties": false, "properties": {
            "default_columns": {"const": 120}, "default_rows": {"const": 24},
            "minimum_pane_rows": {"const": 3}, "anchor_rows": {"const": 1},
            "quiet_seconds": {"type": "integer", "minimum": 1, "maximum": 300},
            "automatic_view_min_seconds": {"type": "integer", "minimum": 1, "maximum": 60},
            "activity_coalesce_ms": {"type": "integer", "minimum": 50, "maximum": 1000},
            "resize_debounce_ms": {"type": "integer", "minimum": 50, "maximum": 1000},
            "ratio_step_percent": {"type": "integer", "minimum": 1, "maximum": 50}, "ratio_max": {"const": 10000}
          }}
        }},
        "context": {"type": "object", "additionalProperties": false, "properties": {
          "max_lines": {"const": 200}, "max_output_bytes": {"const": 32768},
          "max_json_bytes": {"const": 65536}
        }},
        "progress": {"type": "object", "additionalProperties": false, "properties": {
          "join_reminder_seconds": {"const": 300}
        }},
        "recovery": {"type": "object", "additionalProperties": false, "properties": {
          "idle_label": {"const": "Idle"}, "completed_label": {"const": "Completed · Idle"},
          "known_apps": {"type": "object", "additionalProperties": false, "properties": {
            "less": {"type": "object", "additionalProperties": false, "properties": {
              "enabled": {"type": "boolean"}, "action": {"const": "quit_q"},
              "max_attempts": {"const": 1},
              "observe_seconds": {"type": "integer", "minimum": 1, "maximum": 10}
            }}
          }}
        }}
      }
    }
  }
}
